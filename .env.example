# LLM: any OpenAI-compatible chat completions API (used by resolve, investigate and audit)
# Cerebras: LLM_BASE_URL=https://api.cerebras.ai/v1
# Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=your_llm_api_key_here
# Model id as the provider lists it (GET <LLM_BASE_URL>/models)
LLM_MODEL=gpt-oss-120b

# Tavily API key (web search used by resolve for app-name input)
TAVILY_API_KEY=your_tavily_api_key_here
